{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MY_FIRST_PROJECT",
      "cwd": "${workspaceFolder}",
      "executable": "my_first_project/build/my_first_project.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "device": "STM32F407",
      "stopAtEntry": true,
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      },
      "runToMain": true,
      "configFiles": [
        "interface/stlink-v2.cfg",
        "target/stm32f4x.cfg"
      ]
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "d:/aravind_git/my-stm32-code/my_first_project/Core/Src",
      "program": "d:/aravind_git/my-stm32-code/my_first_project/Core/Src/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}